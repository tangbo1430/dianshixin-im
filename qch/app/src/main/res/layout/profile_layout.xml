<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/self_detail_area"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#EDEDED"
        android:orientation="horizontal"
        android:paddingTop="30dp">


        <com.tencent.qcloud.tuikit.timcommon.component.gatherimage.ShadeImageView
            android:id="@+id/self_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="14dp"
            android:scaleType="fitXY"
            android:src="#000000" />

        <TextView
            android:id="@+id/self_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@+id/self_icon"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/self_nick_name"
            android:src="@mipmap/icon_edit_info" />

        <TextView
            android:id="@+id/self_account_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/self_nick_name"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@+id/self_icon"
            android:text="@string/demo_account_tag"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/self_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/self_nick_name"
            android:layout_marginTop="12dp"
            android:layout_toRightOf="@+id/self_account_tag"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/self_signature_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_signature_tag"
            android:textSize="@dimen/demo_profile_account_text_size"
            android:visibility="gone" />


        <TextView
            android:id="@+id/self_signature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/demo_profile_signature_text_size"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/self_icon"
            android:layout_alignBottom="@+id/self_icon"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/tvToday"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:src="@mipmap/icon_today_sign" />

            <ImageView
                android:id="@+id/imQRCode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="10dp"
                android:padding="6dp"
                android:src="@mipmap/icon_mine_qr_code" />


        </LinearLayout>

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/ll_settings_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    </LinearLayout>

    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_gray_bg"
        android:drawableLeft="@mipmap/icon_my_list2"
        android:drawableRight="@drawable/arrow_right2"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:text="邀请好友"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_gray_bg"
        android:drawableLeft="@drawable/icon_my_list4"
        android:drawableRight="@drawable/arrow_right2"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:text="扫一扫"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_gray_bg"
        android:drawableLeft="@drawable/icon_my_list6"
        android:drawableRight="@drawable/arrow_right2"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:text="平台客服"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/tv5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_gray_bg"
        android:drawableLeft="@drawable/icon_my_list5"
        android:drawableRight="@drawable/arrow_right2"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:text="关于我们"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/tv7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_gray_bg"
        android:drawableLeft="@drawable/icon_my_list7"
        android:drawableRight="@drawable/arrow_right2"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:text="设置"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/logout_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/demo_logout_btn_height"
        android:layout_margin="14dp"
        android:background="@drawable/shape_black_bg"
        android:gravity="center"
        android:lineHeight="24.96sp"
        android:text="@string/exit"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="16.32sp"
        android:textStyle="bold" />

</LinearLayout>
